[Unit]
Description=Newchat Vite preview on 127.0.0.1:4173
After=network.target newchat-backend.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/chat-app/src/frontend
ExecStart=/root/.nvm/versions/node/v22.22.0/bin/npm run preview -- --host 127.0.0.1 --port 4173
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
